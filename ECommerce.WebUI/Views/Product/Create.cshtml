@model ECommerce.WebUI.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="product-page">

    <div class="page-header">
        <div>
            <h1>Create Product</h1>
            <p>Add a new product to your store.</p>
        </div>

        <a asp-action="Index" class="back-button">
            Back to Products
        </a>
    </div>

    <div class="product-form-card">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <!-- Product Name -->
            <div class="form-group">
                <label asp-for="Name">Product Name</label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Enter product name" />

                <span asp-validation-for="Name"
                      class="validation-message">
                </span>
            </div>

            <!-- Description -->
            <div class="form-group">
                <label asp-for="Description">Description</label>

                <textarea asp-for="Description"
                          class="form-control description-box"
                          placeholder="Enter product description"></textarea>

                <span asp-validation-for="Description"
                      class="validation-message">
                </span>
            </div>

            <div class="form-row">

                <!-- Price -->
                
                <div class="form-group">
                    <label asp-for="Price">Price</label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           placeholder="0.00" />

                    <span asp-validation-for="Price"
                          class="validation-message">
                    </span>
                </div>

                <!-- Quantity -->
                <div class="form-group">
                    <label asp-for="AvailableQuantity">
                        Available Quantity
                    </label>

                    <input asp-for="AvailableQuantity"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="0" />

                    <span asp-validation-for="AvailableQuantity"
                          class="validation-message">
                    </span>
                </div>

            </div>

            <!-- Category -->
            <div class="form-group">
                <label asp-for="CategoryId">Category</label>

                <select asp-for="CategoryId"
                        asp-items="Model.Categories"
                        class="form-control">

                    <option value="">-- Select Category --</option>

                </select>

                <span asp-validation-for="CategoryId"
                      class="validation-message">
                </span>
            </div>

            <!-- Image -->
            <div class="form-group">

                <label asp-for="ImageFile">
                    Product Image
                </label>

                <input asp-for="ImageFile"
                       type="file"
                       accept="image/*"
                       class="form-control file-input" />

                <small class="file-hint">
                    Select an image for your product.
                </small>

                <span asp-validation-for="ImageFile"
                      class="validation-message">
                </span>

            </div>

            <!-- Buttons -->
            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">
                    Cancel
                </a>

                <button type="submit"
                        class="submit-button">
                    Add Product
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .product-page {
        max-width: 1000px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e2e2e2;
    }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 32px;
            font-weight: 700;
            color: #0b0b0b;
        }

        .page-header p {
            margin: 0;
            color: #777;
        }

    .back-button {
        display: inline-block;
        padding: 11px 20px;
        border: 1px solid #d4af37;
        border-radius: 10px;
        color: #b8860b;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
        white-space: nowrap;
    }

        .back-button:hover {
            background: #d4af37;
            color: #0b0b0b;
        }

    .product-form-card {
        background: #fff;
        border: 1px solid #e2e2e2;
        border-radius: 18px;
        padding: 35px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
            color: #222;
        }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #d8d8d8;
        border-radius: 10px;
        font-size: 15px;
        box-sizing: border-box;
        transition: 0.3s;
        background: #fff;
    }

        .form-control:focus {
            outline: none;
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.12);
        }

    .description-box {
        min-height: 130px;
        resize: vertical;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .file-input {
        padding: 10px;
        cursor: pointer;
    }

    .file-hint {
        display: block;
        margin-top: 7px;
        color: #888;
        font-size: 13px;
    }

    .validation-summary {
        color: #dc3545;
        margin-bottom: 20px;
    }

    .validation-message {
        display: block;
        margin-top: 6px;
        color: #dc3545;
        font-size: 13px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #e5e5e5;
    }

    .cancel-button,
    .submit-button {
        padding: 12px 25px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: 0.3s;
    }

    .cancel-button {
        background: #fff;
        border: 1px solid #d4af37;
        color: #b8860b;
    }

        .cancel-button:hover {
            background: #d4af37;
            color: #0b0b0b;
        }

    .submit-button {
        background: #0b0b0b;
        border: 1px solid #0b0b0b;
        color: #d4af37;
    }

        .submit-button:hover {
            background: #d4af37;
            border-color: #d4af37;
            color: #0b0b0b;
        }

    @@media (max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .back-button {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }

        .product-form-card {
            padding: 25px 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-actions {
            flex-direction: column;
        }

        .cancel-button,
        .submit-button {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }
    }

</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll('input[type="number"]').forEach(input => {
            input.addEventListener('keydown', function(e) {
                if (e.key === '-' || e.key === 'e' || e.key === 'E') {
                    e.preventDefault();
                }
            });
        });
    </script>
}