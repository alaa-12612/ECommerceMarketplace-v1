@model ECommerce.WebUI.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="edit-header">

        <div>
            <span class="edit-label">
                SELLER CENTER
            </span>

            <h1>
                Edit Product
            </h1>

            <p>
                Update your product information and keep your inventory up to date.
            </p>
        </div>

        <a asp-action="Index"
           class="back-button">
            ← Back to Products
        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="edit-card">

                <!-- Card Header -->
                <div class="edit-card-header">

                    <div>
                        <span>
                            PRODUCT MANAGEMENT
                        </span>

                        <h4>
                            Edit Product Information
                        </h4>

                        <p>
                            Update the details below and save your changes.
                        </p>
                    </div>

                    <div class="edit-icon">
                        ✎
                    </div>

                </div>


                <!-- Form -->
                <div class="edit-card-body">

                    <form asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="ExistingImageUrl" />


                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- Product Name -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label">
                                Product Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter product name..." />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label">
                                Product Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe your product..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Price + Quantity -->
                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label asp-for="Price"
                                       class="form-label">
                                    Price
                                </label>

                                <div class="input-group">

                                    <input asp-for="Price"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           class="form-control"
                                           placeholder="0.00" />
                                    <span class="input-group-text">
                                        USD
                                    </span>

                                </div>

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-4">

                                <label asp-for="AvailableQuantity"
                                       class="form-label">
                                    Available Quantity
                                </label>

                                <input asp-for="AvailableQuantity"
                                       type="number"
                                       min="0"
                                       class="form-control"
                                       placeholder="Enter quantity..." />

                                <span asp-validation-for="AvailableQuantity"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Category -->
                        <div class="mb-4">

                            <label asp-for="CategoryId"
                                   class="form-label">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="Model.Categories"
                                    class="form-select">

                                <option value="">
                                    Select a category
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Current Image -->
                        <div class="mb-4">

                            <label class="form-label">
                                Current Product Image
                            </label>

                            <div class="current-image-box">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                                {
                                    var currentImage = Model.ExistingImageUrl;

                                    if (currentImage.StartsWith("http",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <img src="@currentImage"
                                             alt="@Model.Name"
                                             class="current-product-image" />
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/images/products/" + currentImage)"
                                             alt="@Model.Name"
                                             class="current-product-image" />
                                    }
                                }
                                else
                                {
                                    <div class="no-current-image">
                                        No Image Available
                                    </div>
                                }

                            </div>

                        </div>


                        <!-- New Image -->
                        <div class="mb-4">

                            <label asp-for="ImageFile"
                                   class="form-label">
                                Change Product Image
                            </label>

                            <div class="image-upload-box">

                                <div class="upload-icon">
                                    ↑
                                </div>

                                <h6>
                                    Upload New Image
                                </h6>

                                <p>
                                    Leave this empty if you want to keep the current image.
                                </p>

                                <input asp-for="ImageFile"
                                       type="file"
                                       class="form-control"
                                       accept="image/*" />

                            </div>

                            <span asp-validation-for="ImageFile"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="form-actions">

                            <a asp-action="Index"
                               class="btn btn-outline-dark">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-gold">

                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* =====================================================
               HEADER
               ===================================================== */

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 35px;
    }

    .edit-label {
        color: #b8860b;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .edit-header h1 {
        color: #0b0b0b;
        font-size: 2.6rem;
        font-weight: 800;
        margin: 8px 0;
    }

    .edit-header p {
        color: #777777;
        margin: 0;
    }


    /* =====================================================
               BACK BUTTON
               ===================================================== */

    .back-button {
        display: inline-block;
        padding: 11px 20px;
        border: 1px solid #0b0b0b;
        border-radius: 10px;
        color: #0b0b0b;
        background: #ffffff;
        text-decoration: none;
        font-weight: 700;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .back-button:hover {
            background: #0b0b0b;
            color: #ffffff;
        }


    /* =====================================================
               CARD
               ===================================================== */

    .edit-card {
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    }

    .edit-card-header {
        background: #0b0b0b;
        color: #ffffff;
        padding: 25px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #d4af37;
    }

        .edit-card-header span {
            display: block;
            color: #d4af37;
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 6px;
        }

        .edit-card-header h4 {
            color: #ffffff;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .edit-card-header p {
            color: #bbbbbb;
            margin: 0;
            font-size: 14px;
        }

    .edit-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #d4af37;
        color: #0b0b0b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        font-weight: 800;
    }

    .edit-card-body {
        padding: 35px 30px;
    }


    /* =====================================================
               FORM
               ===================================================== */

    .form-label {
        color: #222222;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 48px;
        border: 1px solid #dddddd;
        border-radius: 10px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .input-group-text {
        background: #0b0b0b;
        color: #d4af37;
        border-color: #0b0b0b;
        font-weight: 700;
        border-radius: 0 10px 10px 0;
    }

    .input-group .form-control {
        border-radius: 10px 0 0 10px;
    }

    .text-danger {
        font-size: 13px;
        font-weight: 600;
    }


    /* =====================================================
               CURRENT IMAGE
               ===================================================== */

    .current-image-box {
        width: 100%;
        min-height: 220px;
        background: #fafafa;
        border: 1px solid #e2e2e2;
        border-radius: 15px;
        padding: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .current-product-image {
        width: 220px;
        height: 220px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #dddddd;
        display: block;
    }

    .no-current-image {
        color: #999999;
        font-size: 14px;
        text-align: center;
    }


    /* =====================================================
               IMAGE UPLOAD
               ===================================================== */

    .image-upload-box {
        background: #fafafa;
        border: 2px dashed #d4af37;
        border-radius: 15px;
        padding: 28px;
        text-align: center;
    }

    .upload-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 12px;
        border-radius: 50%;
        background: #0b0b0b;
        color: #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
    }

    .image-upload-box h6 {
        font-weight: 800;
        margin-bottom: 6px;
    }

    .image-upload-box p {
        color: #777777;
        font-size: 14px;
        margin-bottom: 18px;
    }

    .image-upload-box .form-control {
        background: #ffffff;
        text-align: left;
    }


    /* =====================================================
               ACTIONS
               ===================================================== */

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding-top: 20px;
        margin-top: 10px;
        border-top: 1px solid #e5e5e5;
    }

    .btn-gold {
        background: #d4af37;
        border: 1px solid #d4af37;
        color: #0b0b0b;
        font-weight: 800;
        padding: 12px 25px;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .btn-gold:hover {
            background: #b8860b;
            border-color: #b8860b;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .btn-outline-dark {
        background: #ffffff;
        border: 1px solid #0b0b0b;
        color: #0b0b0b;
        font-weight: 700;
        padding: 12px 25px;
        border-radius: 10px;
    }

        .btn-outline-dark:hover {
            background: #0b0b0b;
            color: #ffffff;
        }


    /* =====================================================
               RESPONSIVE
               ===================================================== */

    @@media (max-width: 768px) {

        .edit-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .back-button {
            width: 100%;
            text-align: center;
        }

        .edit-header h1 {
            font-size: 2rem;
        }

        .edit-card-header {
            padding: 20px;
        }

        .edit-card-body {
            padding: 25px 20px;
        }

        .current-product-image {
            width: 180px;
            height: 180px;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .form-actions .btn {
                width: 100%;
                text-align: center;
            }
    }

</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll('input[type="number"]').forEach(input => {
            input.addEventListener('keydown', function(e) {
                if (e.key === '-' || e.key === 'e' || e.key === 'E') {
                    e.preventDefault();
                }
            });
        });
    </script>
}