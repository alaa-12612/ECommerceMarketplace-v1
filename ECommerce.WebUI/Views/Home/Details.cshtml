@model ECommerce.WebUI.ViewModels.ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Product.Name;
}

<div class="container py-5">

    <!-- Product Details -->
    <div class="row g-5 align-items-start">

        <!-- Product Image -->
        <div class="col-md-5">

            @if (!string.IsNullOrWhiteSpace(Model.Product.ImageUrl))
            {
                var imageUrl = Model.Product.ImageUrl;

                if (imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                {
                    <img src="@imageUrl"
                         alt="@Model.Product.Name"
                         class="product-details-image" />
                }
                else
                {
                    <img src="@Url.Content("~/images/products/" + imageUrl)"
                         alt="@Model.Product.Name"
                         class="product-details-image" />
                }
            }
            else
            {
                <div class="no-product-image">
                    <span>No Image Available</span>
                </div>
            }

        </div>


        <!-- Product Information -->
        <div class="col-lg-6">

            <div class="product-details-content">

                <span class="product-details-label">
                    PRODUCT DETAILS
                </span>

                <h1 class="product-details-title">
                    @Model.Product.Name
                </h1>

                <!-- Overall Rating Badge -->
                <div class="product-overall-rating mb-3">
                    @if (Model.TotalReviews > 0)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <div class="rating-stars" style="color: #d4af37; font-size: 1.15rem; letter-spacing: 2px;">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.OverallRating))
                                    {
                                        <span>★</span>
                                    }
                                    else
                                    {
                                        <span style="color: #ddd;">★</span>
                                    }
                                }
                            </div>
                            <span class="fw-bold" style="color: #111; font-size: 1.05rem;">@Model.OverallRating.ToString("0.0")</span>
                            <span class="text-muted" style="font-size: 0.9rem;">(@Model.TotalReviews @(Model.TotalReviews == 1 ? "review" : "reviews"))</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.9rem;">
                            <span style="color: #ddd; letter-spacing: 2px; font-size: 1.15rem;">★★★★★</span>
                            <span>No ratings yet</span>
                        </div>
                    }
                </div>

                <div class="product-details-price">
                    @Model.Product.Price.ToString("C")
                </div>

                <div class="product-details-divider"></div>

                <p class="product-details-description">
                    @Model.Product.Description
                </p>


                <!-- Product Information -->
                <div class="product-info-box">

                    <div class="product-info-item">

                        <span class="info-label">
                            Category
                        </span>

                        <span class="info-value">
                            @(Model.Product.Category?.Name ?? "Uncategorized")
                        </span>

                    </div>


                    <div class="product-info-item">

                        <span class="info-label">
                            Available Quantity
                        </span>

                        <span class="info-value">
                            @Model.Product.AvailableQuantity
                        </span>

                    </div>


                    <div class="product-info-item">

                        <span class="info-label">
                            Availability
                        </span>

                        @if (Model.Product.AvailableQuantity > 0)
                        {
                            <span class="stock-available">
                                In Stock
                            </span>
                        }
                        else
                        {
                            <span class="stock-unavailable">
                                Out of Stock
                            </span>
                        }

                    </div>

                </div>


                <!-- Actions -->
                @if (Model.Product.AvailableQuantity > 0)
                {
                    <div class="product-actions">

                        <!-- Add To Cart -->
                        <form asp-controller="Cart"
                              asp-action="AddToCart"
                              method="post"
                              class="flex-grow-1">

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.Product.Id" />

                            <button type="submit"
                                    class="btn btn-gold w-100">

                                <span>🛒</span>
                                Add to Cart

                            </button>

                        </form>


                        <!-- Wishlist -->
                        <form asp-controller="Wishlist"
                              asp-action="AddToWishlist"
                              method="post">

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.Product.Id" />

                            <button type="submit"
                                    class="btn btn-wishlist"
                                    title="Add to Wishlist">

                                ♡

                            </button>

                        </form>

                    </div>
                }
                else
                {
                    <button class="btn btn-secondary w-100"
                            disabled>

                        Out of Stock

                    </button>
                }


                <!-- Back -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="back-to-shop">

                    ← Back to Shop

                </a>

            </div>

        </div>

    </div>


    <!-- Reviews Section -->
    <div class="reviews-section">

        <div class="section-heading d-flex flex-wrap justify-content-between align-items-end mb-4">

            <div>
                <span>PRODUCT REVIEWS</span>
                <h2>Customer Reviews</h2>
            </div>

            @if (Model.TotalReviews > 0)
            {
                <div class="overall-rating-summary p-3 rounded-3" style="background: #fafafa; border: 1px solid #e2e2e2; display: flex; align-items: center; gap: 15px;">
                    <div class="text-center">
                        <div style="font-size: 2rem; font-weight: 800; color: #b8860b; line-height: 1;">@Model.OverallRating.ToString("0.0")</div>
                        <small class="text-muted" style="font-size: 0.75rem;">out of 5</small>
                    </div>
                    <div style="height: 35px; width: 1px; background: #ddd;"></div>
                    <div>
                        <div style="color: #d4af37; font-size: 1rem; letter-spacing: 2px;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.OverallRating))
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span style="color: #ddd;">★</span>
                                }
                            }
                        </div>
                        <small class="text-muted" style="font-weight: 600;">Based on @Model.TotalReviews @(Model.TotalReviews == 1 ? "review" : "reviews")</small>
                    </div>
                </div>
            }

        </div>


        <!-- Add Review -->
        @if (Model.CanReview)
        {
            <div class="review-form-card">

                <div class="review-form-header">

                    <h4>
                        Write a Review
                    </h4>

                    <p>
                        Share your experience with this product.
                    </p>

                </div>


                <form asp-controller="Review"
                      asp-action="AddReview"
                      method="post">

                    <input type="hidden"
                           name="productId"
                           value="@Model.Product.Id" />


                    <div class="mb-4">

                        <label class="form-label">
                            Rating
                        </label>

                        <select name="rating"
                                class="form-select"
                                required>

                            <option value="">
                                Select your rating
                            </option>

                            <option value="5">
                                ⭐⭐⭐⭐⭐ - Excellent
                            </option>

                            <option value="4">
                                ⭐⭐⭐⭐ - Very Good
                            </option>

                            <option value="3">
                                ⭐⭐⭐ - Good
                            </option>

                            <option value="2">
                                ⭐⭐ - Fair
                            </option>

                            <option value="1">
                                ⭐ - Poor
                            </option>

                        </select>

                    </div>


                    <div class="mb-4">

                        <label class="form-label">
                            Your Review
                        </label>

                        <textarea name="comment"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Write your review here..."
                                  required></textarea>

                    </div>


                    <button type="submit"
                            class="btn btn-gold">

                        Submit Review

                    </button>

                </form>

            </div>
        }
        else if (!User.Identity.IsAuthenticated)
        {
            <div class="login-review-message">

                <div>

                    <strong>
                        Want to review this product?
                    </strong>

                    <p class="mb-0">
                        Please sign in to share your experience.
                    </p>

                </div>


                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-gold">

                    Sign In

                </a>

            </div>
        }


        <!-- Existing Reviews -->
        @if (Model.Reviews == null || !Model.Reviews.Any())
        {
            <div class="no-reviews">

                <div class="no-reviews-icon">
                    ☆
                </div>

                <h4>
                    No Reviews Yet
                </h4>

                <p>
                    Be the first customer to review this product.
                </p>

            </div>
        }
        else
        {
            <div class="reviews-list">

                @foreach (var review in Model.Reviews)
                {
                    <div class="review-card">

                        <div class="review-top">

                            <div class="review-user">

                                <div class="user-avatar">
                                    @(review.Customer?.FullName?.Substring(0, 1).ToUpper() ?? "C")
                                </div>


                                <div>

                                    <h5>
                                        @(review.Customer?.FullName ?? "Customer")
                                    </h5>

                                    <span>
                                        @review.CreatedAt.ToString("dd MMM yyyy")
                                    </span>

                                </div>

                            </div>


                            <div class="review-stars">

                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <span>★</span>
                                }

                                @for (int i = review.Rating; i < 5; i++)
                                {
                                    <span class="empty-star">
                                        ★
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="review-comment">
                            @review.Comment
                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>


<style>

    /* =====================================================
               PRODUCT IMAGE
               ===================================================== */

    .product-details-image {
        width: 100%;
        height: 500px;
        object-fit: cover;
        display: block;
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-radius: 20px;
        transition: transform 0.4s ease;
    }

        .product-details-image:hover {
            transform: scale(1.03);
        }

    .no-product-image {
        width: 100%;
        height: 500px;
        background: #151515;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888;
        font-size: 1rem;
        border-radius: 20px;
    }


    /* =====================================================
               PRODUCT CONTENT
               ===================================================== */

    .product-details-content {
        padding: 15px 10px;
    }

    .product-details-label {
        color: #b8860b;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .product-details-title {
        font-family: 'Outfit', sans-serif;
        font-size: 2.8rem;
        font-weight: 800;
        color: #0b0b0b;
        margin: 12px 0 15px;
        line-height: 1.15;
    }

    .product-details-price {
        font-size: 2rem;
        font-weight: 800;
        color: #b8860b;
    }

    .product-details-divider {
        height: 1px;
        background: #e2e2e2;
        margin: 25px 0;
    }

    .product-details-description {
        color: #666666;
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 25px;
    }


    /* =====================================================
               PRODUCT INFO
               ===================================================== */

    .product-info-box {
        background: #fafafa;
        border: 1px solid #e2e2e2;
        border-radius: 14px;
        margin-bottom: 25px;
    }

    .product-info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 18px;
        border-bottom: 1px solid #e2e2e2;
    }

        .product-info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        color: #777;
        font-size: 0.9rem;
    }

    .info-value {
        color: #111;
        font-weight: 700;
    }

    .stock-available {
        color: #198754;
        font-weight: 700;
    }

    .stock-unavailable {
        color: #dc3545;
        font-weight: 700;
    }


    /* =====================================================
               BUTTONS
               ===================================================== */

    .product-actions {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

    .btn-gold {
        background: #d4af37;
        border: 1px solid #d4af37;
        color: #111111;
        font-weight: 800;
        border-radius: 10px;
        padding: 13px 25px;
        transition: all 0.2s ease;
    }

        .btn-gold:hover {
            background: #b8860b;
            border-color: #b8860b;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .btn-wishlist {
        width: 54px;
        height: 54px;
        border: 1px solid #d4af37;
        background: #ffffff;
        color: #b8860b;
        border-radius: 10px;
        font-size: 1.7rem;
        line-height: 1;
        transition: all 0.2s ease;
    }

        .btn-wishlist:hover {
            background: #d4af37;
            color: #111111;
        }

    .back-to-shop {
        display: inline-block;
        margin-top: 22px;
        color: #555;
        text-decoration: none;
        font-weight: 600;
    }

        .back-to-shop:hover {
            color: #b8860b;
        }


    /* =====================================================
               REVIEWS
               ===================================================== */

    .reviews-section {
        margin-top: 80px;
        padding-top: 55px;
        border-top: 1px solid #e2e2e2;
    }

    .section-heading {
        margin-bottom: 30px;
    }

        .section-heading span {
            color: #b8860b;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .section-heading h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 2rem;
            font-weight: 800;
            color: #0b0b0b;
            margin-top: 7px;
        }


    /* =====================================================
               REVIEW FORM
               ===================================================== */

    .review-form-card {
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-top: 3px solid #d4af37;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 35px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .review-form-header h4 {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .review-form-header p {
        color: #777;
        margin-bottom: 25px;
    }

    .review-form-card .form-label {
        font-weight: 700;
    }

    .review-form-card .form-control,
    .review-form-card .form-select {
        border-radius: 10px;
        border: 1px solid #ddd;
    }

        .review-form-card .form-control:focus,
        .review-form-card .form-select:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.15);
        }


    /* =====================================================
               LOGIN MESSAGE
               ===================================================== */

    .login-review-message {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px 25px;
        background: #151515;
        color: #ffffff;
        border-radius: 14px;
        margin-bottom: 35px;
        border-left: 4px solid #d4af37;
    }

        .login-review-message strong {
            color: #d4af37;
        }

        .login-review-message p {
            color: #bbb;
            margin-top: 5px;
        }


    /* =====================================================
               NO REVIEWS
               ===================================================== */

    .no-reviews {
        text-align: center;
        padding: 60px 20px;
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-radius: 15px;
    }

    .no-reviews-icon {
        font-size: 3rem;
        color: #d4af37;
        margin-bottom: 10px;
    }

    .no-reviews h4 {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
    }

    .no-reviews p {
        color: #777;
    }


    /* =====================================================
               REVIEW CARD
               ===================================================== */

    .review-card {
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 18px;
        transition: all 0.2s ease;
    }

        .review-card:hover {
            border-color: #d4af37;
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.08);
        }

    .review-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 18px;
    }

    .review-user {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #151515;
        color: #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
    }

    .review-user h5 {
        margin: 0;
        font-weight: 700;
    }

    .review-user span {
        color: #888;
        font-size: 0.8rem;
    }

    .review-stars {
        color: #d4af37;
        letter-spacing: 2px;
        white-space: nowrap;
    }

    .empty-star {
        color: #ddd;
    }

    .review-comment {
        color: #555;
        line-height: 1.7;
        padding-left: 57px;
    }


    /* =====================================================
               RESPONSIVE
               ===================================================== */

    @@media (max-width: 768px) {

        .product-details-title {
            font-size: 2rem;
        }

        .product-details-price {
            font-size: 1.5rem;
        }

        .product-details-image,
        .no-product-image {
            height: 350px;
        }

        .product-actions {
            flex-direction: column;
        }

            .product-actions form {
                width: 100%;
            }

        .btn-wishlist {
            width: 100%;
        }

        .review-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .review-comment {
            padding-left: 0;
        }

        .login-review-message {
            flex-direction: column;
            align-items: flex-start;
        }
    }

</style>