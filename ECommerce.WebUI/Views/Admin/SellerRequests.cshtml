@model IEnumerable<ECommerce.Domain.Entities.ApplicationUser>

@{
    ViewData["Title"] = "Seller Requests";
}

<div class="admin-page">

    <div class="page-header">

        <div>
            <h2>🏪 Seller Requests</h2>

            <p>
                Review users who want to become sellers.
            </p>
        </div>

        <a asp-action="Index"
           class="gold-button">

            ← Dashboard

        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-box">

            No pending seller requests.

        </div>
    }
    else
    {
        <div class="table-card">

            <div class="table-responsive">

                <table class="admin-table">

                    <thead>

                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @user.FullName
                                    </strong>
                                </td>

                                <td>
                                    @user.Email
                                </td>

                                <td>

                                    <div class="action-group">

                                        <form asp-controller="Admin"
                                              asp-action="ApproveSeller"
                                              method="post">

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="approve-button">

                                                ✓ Approve

                                            </button>

                                        </form>


                                        <form asp-controller="Admin"
                                              asp-action="RejectSeller"
                                              method="post">

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="reject-button">

                                                ✕ Reject

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


<style>

    .admin-page {
        padding: 30px 0;
    }

    .page-header {
        background: #000;
        color: white;
        padding: 25px;
        border-radius: 16px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 3px solid #D4AF37;
    }

        .page-header h2 {
            color: #D4AF37;
            margin: 0;
            font-weight: 700;
        }

        .page-header p {
            margin: 5px 0 0;
            color: #ccc;
        }

    .gold-button {
        background: #D4AF37;
        color: #000;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    .table-card {
        background: white;
        border-radius: 15px;
        padding: 15px;
        box-shadow: 0 5px 18px rgba(0,0,0,.08);
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

        .admin-table th {
            background: #000;
            color: #D4AF37;
            padding: 15px;
            text-align: left;
        }

        .admin-table td {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }

    .action-group {
        display: flex;
        gap: 8px;
    }

    .approve-button,
    .reject-button {
        border: none;
        padding: 8px 14px;
        border-radius: 7px;
        font-weight: 600;
        cursor: pointer;
    }

    .approve-button {
        background: #000;
        color: #D4AF37;
    }

        .approve-button:hover {
            background: #D4AF37;
            color: #000;
        }

    .reject-button {
        background: #eee;
        color: #333;
    }

        .reject-button:hover {
            background: #000;
            color: #D4AF37;
        }

    .empty-box {
        padding: 30px;
        background: #f8f8f8;
        border-radius: 12px;
        text-align: center;
    }

</style>