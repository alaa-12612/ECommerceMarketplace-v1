@model IEnumerable<ECommerce.Domain.Entities.WishlistItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<div class="wishlist-page">

    <div class="wishlist-header">
        <div>
            <h1>My Wishlist</h1>
            <p>Save your favorite products and find them easily later.</p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="continue-shopping">
            Continue Shopping
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-wishlist">

            <div class="empty-icon">♡</div>

            <h2>Your Wishlist is Empty</h2>

            <p>
                You haven't added any products to your wishlist yet.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="browse-button">
                Browse Products
            </a>

        </div>
    }
    else
    {
        <div class="wishlist-grid">

            @foreach (var item in Model)
            {
                <div class="wishlist-card">

                    <div class="wishlist-image-container">

                        @if (!string.IsNullOrWhiteSpace(item.Product.ImageUrl))
                        {
                            var imageUrl = item.Product.ImageUrl;

                            @if (imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            {
                                <img src="@imageUrl"
                                     class="wishlist-image"
                                     alt="@item.Product.Name" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/images/products/" + imageUrl)"
                                     class="wishlist-image"
                                     alt="@item.Product.Name" />
                            }
                        }
                        else
                        {
                            <div class="no-image">
                                No Image
                            </div>
                        }

                        <div class="wishlist-badge">
                            ♥ Favorite
                        </div>

                    </div>

                    <div class="wishlist-content">

                        <h3>@item.Product.Name</h3>

                        <p class="wishlist-price">
                            @item.Product.Price.ToString("C")
                        </p>

                        <div class="wishlist-actions">

                            <form asp-controller="Cart"
                                  asp-action="AddToCart"
                                  method="post">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <button type="submit"
                                        class="add-cart-button">
                                    Add to Cart
                                </button>

                            </form>

                            <form asp-action="RemoveFromWishlist"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="remove-button">
                                    Remove
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>

    .wishlist-page {
        padding: 45px 20px;
        max-width: 1200px;
        margin: auto;
    }

    .wishlist-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 35px;
        padding-bottom: 25px;
        border-bottom: 1px solid #e2e2e2;
    }

        .wishlist-header h1 {
            margin: 0 0 8px;
            color: #0b0b0b;
            font-size: 34px;
            font-weight: 700;
        }

        .wishlist-header p {
            margin: 0;
            color: #777;
        }

    .continue-shopping {
        display: inline-block;
        padding: 11px 20px;
        border-radius: 10px;
        border: 1px solid #d4af37;
        color: #b8860b;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
        white-space: nowrap;
    }

        .continue-shopping:hover {
            background: #d4af37;
            color: #0b0b0b;
        }

    .wishlist-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .wishlist-card {
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .wishlist-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
        }

    .wishlist-image-container {
        height: 230px;
        position: relative;
        background: #f5f5f5;
        overflow: hidden;
    }

    .wishlist-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }

    .wishlist-card:hover .wishlist-image {
        transform: scale(1.05);
    }

    .wishlist-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #0b0b0b;
        color: #d4af37;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .no-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888;
        font-size: 14px;
    }

    .wishlist-content {
        padding: 20px;
    }

        .wishlist-content h3 {
            color: #222;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 10px;
            min-height: 45px;
        }

    .wishlist-price {
        color: #b8860b;
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .wishlist-actions {
        display: flex;
        gap: 10px;
    }

        .wishlist-actions form {
            flex: 1;
            margin: 0;
        }

    .add-cart-button,
    .remove-button {
        width: 100%;
        padding: 10px 8px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
    }

    .add-cart-button {
        border: 1px solid #0b0b0b;
        background: #0b0b0b;
        color: #d4af37;
    }

        .add-cart-button:hover {
            background: #d4af37;
            color: #0b0b0b;
        }

    .remove-button {
        border: 1px solid #d4af37;
        background: #ffffff;
        color: #b8860b;
    }

        .remove-button:hover {
            background: #d4af37;
            color: #0b0b0b;
        }

    .empty-wishlist {
        text-align: center;
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-radius: 20px;
        padding: 70px 25px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
    }

    .empty-icon {
        font-size: 70px;
        color: #d4af37;
        margin-bottom: 15px;
    }

    .empty-wishlist h2 {
        color: #0b0b0b;
        font-size: 28px;
        margin-bottom: 10px;
    }

    .empty-wishlist p {
        color: #777;
        margin-bottom: 25px;
    }

    .browse-button {
        display: inline-block;
        background: #0b0b0b;
        color: #d4af37;
        padding: 12px 25px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
    }

        .browse-button:hover {
            background: #d4af37;
            color: #0b0b0b;
        }

    @@media (max-width: 992px) {

        .wishlist-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {

        .wishlist-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .wishlist-grid {
            grid-template-columns: 1fr;
        }

        .wishlist-header h1 {
            font-size: 28px;
        }

        .continue-shopping {
            width: 100%;
            text-align: center;
        }

        .wishlist-actions {
            flex-direction: column;
        }
    }

</style>