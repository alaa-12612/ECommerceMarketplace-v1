@model int

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-5">

    <div class="confirmation-wrapper">

        <div class="confirmation-card">

            <!-- Success Icon -->
            <div class="success-icon">
                ✓
            </div>

            <!-- Title -->
            <span class="confirmation-label">
                ORDER CONFIRMED
            </span>

            <h1>
                Order Placed Successfully!
            </h1>

            <p class="confirmation-message">
                Thank you for your purchase. Your order has been received
                and is now being prepared.
            </p>


            <!-- Order Number -->
            <div class="order-number-box">

                <span>
                    ORDER NUMBER
                </span>

                <strong>
                    #@Model
                </strong>

            </div>


            <p class="shipping-message">
                Your order is being prepared and will be shipped as soon as possible.
            </p>


            <!-- Actions -->
            <div class="confirmation-actions">

                <a asp-controller="Order"
                   asp-action="MyOrders"
                   class="btn btn-gold">

                    View My Orders

                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-dark">

                    Continue Shopping

                </a>

            </div>

        </div>

    </div>

</div>


<style>

    /* =====================================================
               ORDER CONFIRMATION
               ===================================================== */

    .confirmation-wrapper {
        min-height: 65vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }


    .confirmation-card {
        width: 100%;
        max-width: 700px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-top: 4px solid #d4af37;
        border-radius: 20px;
        padding: 55px 40px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.07);
    }


    /* =====================================================
               SUCCESS ICON
               ===================================================== */

    .success-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 25px;
        border-radius: 50%;
        background: #151515;
        color: #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: 800;
        border: 3px solid #d4af37;
    }


    /* =====================================================
               TEXT
               ===================================================== */

    .confirmation-label {
        color: #b8860b;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 2px;
    }


    .confirmation-card h1 {
        color: #0b0b0b;
        font-size: 2.4rem;
        font-weight: 800;
        margin: 10px 0 15px;
    }


    .confirmation-message {
        color: #666666;
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 560px;
        margin: 0 auto 25px;
    }


    .shipping-message {
        color: #888888;
        font-size: 0.9rem;
        margin-top: 20px;
    }


    /* =====================================================
               ORDER NUMBER
               ===================================================== */

    .order-number-box {
        background: #151515;
        border-radius: 14px;
        padding: 20px 30px;
        margin: 25px auto;
        max-width: 350px;
    }


        .order-number-box span {
            display: block;
            color: #d4af37;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 6px;
        }


        .order-number-box strong {
            color: #ffffff;
            font-size: 1.8rem;
            font-weight: 800;
        }


    /* =====================================================
               BUTTONS
               ===================================================== */

    .confirmation-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 30px;
    }


    .btn-gold {
        background: #d4af37;
        border: 1px solid #d4af37;
        color: #111111;
        font-weight: 800;
        border-radius: 10px;
        padding: 12px 24px;
        transition: all 0.2s ease;
    }


        .btn-gold:hover {
            background: #b8860b;
            border-color: #b8860b;
            color: #ffffff;
            transform: translateY(-2px);
        }


    .btn-outline-dark {
        border: 1px solid #222222;
        color: #222222;
        background: #ffffff;
        font-weight: 700;
        border-radius: 10px;
        padding: 12px 24px;
        transition: all 0.2s ease;
    }


        .btn-outline-dark:hover {
            background: #151515;
            color: #ffffff;
            border-color: #151515;
        }


    /* =====================================================
               RESPONSIVE
               ===================================================== */

    @@media (max-width: 576px) {

        .confirmation-card {
            padding: 40px 20px;
        }

            .confirmation-card h1 {
                font-size: 1.8rem;
            }

        .confirmation-actions {
            flex-direction: column;
        }

            .confirmation-actions a {
                width: 100%;
            }
    }

</style>